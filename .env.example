# ==============================================================================
# FUNKY FOX ECOMMERCE & ADMIN PORTAL ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Required for Admin Auth & Cloud Data Persistence)
# ------------------------------------------------------------------------------
# Obtain these from your Supabase project dashboard -> Settings -> API
VITE_SUPABASE_URL=#
VITE_SUPABASE_ANON_KEY=#
# Service role key (USED EXCLUSIVELY BY SUPABASE EDGE FUNCTIONS - NEVER IN CLIENT CODE)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY (Required for Payment Processing & Webhooks)
# ------------------------------------------------------------------------------
# Obtain these from Razorpay Dashboard -> Settings -> API Keys & Webhooks
VITE_RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret

# ------------------------------------------------------------------------------
# SHIPROCKET LOGISTICS (Required for automated AWB, Labels & Tracking)
# ------------------------------------------------------------------------------
# Obtain from Shiprocket API settings
SHIPROCKET_EMAIL=operations@funkyfox.in
SHIPROCKET_PASSWORD=your_shiprocket_api_password
SHIPROCKET_PICKUP_LOCATION=Primary Warehouse
