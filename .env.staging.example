# ==============================================================================
# FUNKY FOX ECOMMERCE & ADMIN PORTAL — ISOLATED STAGING ENVIRONMENT
# ==============================================================================
# IMPORTANT SECURITY RULES:
# 1. NEVER point staging to production database or copy production credentials here.
# 2. NEVER import production customer Personal Identifiable Information (PII) into staging.
# 3. Copy this template to .env.staging or .env.local during staging validation.
# ==============================================================================

# Supabase Staging Project (Obtain from Staging Project Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-staging-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-staging-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-staging-anon-key

# Staging Database Direct Access (Used strictly by CLI migration runner - NEVER in frontend)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
STAGING_DATABASE_URL=postgresql://postgres.your-staging-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Staging Environment Mode Flag
VITE_APP_ENV=staging
